<Project>

  <!-- ─── Целевые платформы ─────────────────────────────────────────────── -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <!-- ─── Возможности языка ──────────────────────────────────────────────── -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- ─── Качество кода ──────────────────────────────────────────────────── -->
  <PropertyGroup>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!-- ─── Детерминированные сборки ───────────────────────────────────────── -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <!-- Установите CI=true в окружении pipeline для воспроизводимых сборок -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- ─── Метаданные сборки ──────────────────────────────────────────────── -->
  <PropertyGroup>
    <Authors>Intelligence TradeSystem</Authors>
    <Product>Intelligence Trade System</Product>
    <Copyright>Copyright © Intelligence TradeSystem $([System.DateTime]::Now.Year)</Copyright>
  </PropertyGroup>

  <!-- ─── Версионирование ────────────────────────────────────────────────── -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!-- ─── Отладка ────────────────────────────────────────────────────────── -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <!-- ─── Release-сборка ─────────────────────────────────────────────────── -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

</Project>
