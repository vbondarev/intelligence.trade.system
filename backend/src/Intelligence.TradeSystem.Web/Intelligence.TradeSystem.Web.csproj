<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <BuildClientAssets Condition="'$(BuildClientAssets)' == ''">true</BuildClientAssets>
    <ClientAppDirectory>$(MSBuildProjectDirectory)\ClientApp\</ClientAppDirectory>
    <DefaultItemExcludes>$(DefaultItemExcludes);ClientApp\node_modules\**;ClientApp\test-results\**;ClientApp\playwright-report\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Intelligence.TradeSystem.ServiceDefaults\Intelligence.TradeSystem.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Intelligence.TradeSystem.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="ClientApp\**" />
    <None Remove="ClientApp\**" />
    <ClientAppSource Include="ClientApp\src\**;ClientApp\index.html;ClientApp\package.json;ClientApp\package-lock.json;ClientApp\vite.config.ts;ClientApp\tsconfig*.json" />
  </ItemGroup>

  <!-- Frontend собирается Vite в wwwroot; CI .NET-jobs и Docker publish передают BuildClientAssets=false. -->
  <Target Name="RestoreClientAppDependencies"
          Condition="'$(BuildClientAssets)' == 'true'"
          BeforeTargets="BeforeBuild"
          Inputs="$(ClientAppDirectory)package-lock.json"
          Outputs="$(ClientAppDirectory)node_modules\.package-lock.json">
    <Exec Command="npm ci" WorkingDirectory="$(ClientAppDirectory)" IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <Target Name="BuildClientApp"
          Condition="'$(BuildClientAssets)' == 'true'"
          AfterTargets="RestoreClientAppDependencies"
          BeforeTargets="BeforeBuild"
          Inputs="@(ClientAppSource)"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\index.html">
    <Exec Command="npm run build" WorkingDirectory="$(ClientAppDirectory)" IgnoreStandardErrorWarningFormat="true" />
  </Target>

  <!-- Content из wwwroot вычисляется при evaluation, до Vite build: без повторного glob static web assets
       получают устаревшие hashed-файлы или не получают их вовсе. Wildcard Remove внутри target раскрывается
       по файловой системе и не удаляет items уже стёртых Vite файлов, поэтому фильтруем по FullPath. -->
  <Target Name="IncludeClientAppAssets"
          Condition="'$(BuildClientAssets)' == 'true'"
          AfterTargets="BuildClientApp"
          BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_ClientAppWebRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', 'wwwroot').ToUpperInvariant())</_ClientAppWebRoot>
    </PropertyGroup>
    <ItemGroup>
      <_EvaluatedClientAppContent Include="@(Content)"
                                  Condition="$([System.String]::Copy('%(Content.FullPath)').ToUpperInvariant().StartsWith('$(_ClientAppWebRoot)'))" />
      <Content Remove="@(_EvaluatedClientAppContent)" />
      <_EvaluatedClientAppContent Remove="@(_EvaluatedClientAppContent)" />
      <Content Include="wwwroot\**"
               Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)"
               ExcludeFromSingleFile="true"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
