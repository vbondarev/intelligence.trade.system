{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SnapshotFreshness": {
    "Intraday": {
      "PriceMaxAge": "00:00:02",
      "DerivativesMaxAge": "00:00:30",
      "OrderBookMaxAge": "00:00:02",
      "TradeFlowMaxAge": "00:00:05",
      "M15MaxAge": "00:01:00",
      "H1MaxAge": "00:01:00",
      "H4MaxAge": "00:01:00",
      "D1MaxAge": "00:01:00"
    },
    "Swing": {
      "PriceMaxAge": "00:00:10",
      "DerivativesMaxAge": "00:02:00",
      "OrderBookMaxAge": "00:00:15",
      "TradeFlowMaxAge": "00:00:30",
      "M15MaxAge": "00:05:00",
      "H1MaxAge": "00:05:00",
      "H4MaxAge": "00:05:00",
      "D1MaxAge": "00:05:00"
    },
    "Portfolio": {
      "PriceMaxAge": "00:00:05",
      "DerivativesMaxAge": "00:01:00",
      "OrderBookMaxAge": "00:00:05",
      "TradeFlowMaxAge": "00:00:10",
      "M15MaxAge": "00:05:00",
      "H1MaxAge": "00:05:00",
      "H4MaxAge": "00:05:00",
      "D1MaxAge": "00:05:00",
      "PortfolioMaxAge": "00:00:30"
    }
  },
  "PublicMarketSnapshotCache": {
    "Enabled": true,
    "EntryLifetime": "00:00:01"
  },
  "ExchangeAccountBackgroundSync": {
    "Enabled": true,
    "Interval": "00:05:00",
    "InitialDelay": "00:00:30",
    "BatchSize": 50,
    "MaxConcurrency": 4
  },
  "ExchangeRealtimeObservation": {
    "Enabled": true,
    "QueueCapacity": 256,
    "AccountConsumerCount": 1,
    "ReconnectInitialDelay": "00:00:01",
    "ReconnectMaxDelay": "00:00:30",
    "ReconnectJitter": 0.2,
    "AccountDiscoveryInterval": "00:00:20",
    "HeartbeatInterval": "00:00:20",
    "HeartbeatStaleAfter": "00:01:00"
  },
  "ApplicationEventOutboxDispatcher": {
    "Enabled": true,
    "PollingInterval": "00:00:05",
    "BatchSize": 100,
    "MaxConcurrency": 4,
    "ClaimDuration": "00:05:00",
    "RetryBaseDelay": "00:00:10"
  },
  "RecommendationPolicy": {
    "Path": "Configuration/recommendation-policy.json"
  },
  "PositionEvaluationPolicy": {
    "assessmentRules": {
      "version": "assessment-v1",
      "rsiOverbought": 70,
      "rsiOversold": 30,
      "nearbyLevelPercent": 1,
      "liquidationDangerPercent": 5,
      "lowVolumeRatio": 0.5,
      "validityPeriod": "00:05:00"
    },
    "portfolioRisk": {
      "minimumFreeCapitalPercent": 20,
      "maximumGrossExposureToEquityPercent": 200,
      "maximumPositionConcentrationPercent": 50
    }
  }
}
