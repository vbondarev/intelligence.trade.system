<Project>

  <!-- ─── Сведения о сборке ───────────────────────────────────────────────── -->
  <!--
    Выводит сводную строку после сборки каждого проекта:
      ▶ Intelligence.TradeSystem.Domain → net10.0 [Debug]
  -->
  <Target Name="PrintBuildInfo" AfterTargets="Build">
    <Message Text="▶ $(MSBuildProjectName) → $(TargetFramework) [$(Configuration)]"
             Importance="High" />
  </Target>

  <!-- ─── Контроль structured logging ───────────────────────────────────── -->
  <!--
    Прерывает сборку, если любой файл .cs содержит вызовы Console.Write.
    Весь вывод должен проходить через ILogger для единообразного structured logging.
  -->
  <Target Name="ValidateNoBannedConsole" BeforeTargets="Build">
    <!--
      Цепочки .Contains() в атрибуте Condition не поддерживаются MSBuild.
      Вместо этого содержимое файла вычисляется через поддерживаемое значение metadata,
      а затем по нему выполняется фильтрация.
    -->
    <ItemGroup>
      <_CsFiles Include="@(Compile)">
        <ContainsConsoleWrite>$([System.IO.File]::ReadAllText('%(FullPath)').Contains('Console.Write'))</ContainsConsoleWrite>
      </_CsFiles>
    </ItemGroup>
    <Error
      Condition="'%(_CsFiles.ContainsConsoleWrite)' == 'True'"
      Text="Console.Write* is banned in %(_CsFiles.Identity). Use ILogger instead." />
  </Target>

</Project>
