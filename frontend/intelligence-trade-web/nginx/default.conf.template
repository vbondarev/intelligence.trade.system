# Единый browser-facing origin: React static application и same-origin proxy в internal BFF.
# BFF_UPSTREAM — deployment setting (scheme://host:port) и не попадает в React bundle.
server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # Proxy задаёт forwarded headers сам: client не может подменить public scheme/host, из которых
    # BFF строит OIDC redirect URIs. X-Forwarded-For дополняется, BFF учитывает только последний адрес.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_redirect off;
    proxy_buffer_size 16k;
    proxy_buffers 8 16k;

    location ^~ /bff/ {
        proxy_pass ${BFF_UPSTREAM};
    }

    location = /bff {
        proxy_pass ${BFF_UPSTREAM};
    }

    location = /signin-oidc {
        proxy_pass ${BFF_UPSTREAM};
    }

    location = /signout-callback-oidc {
        proxy_pass ${BFF_UPSTREAM};
    }

    # Отсутствующий hashed asset возвращает 404, а не index.html.
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri /index.html;
    }
}
